# Application Server Configuration
PORT=8080
ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=loan_management_db
DB_SSLMODE=disable

# JWT Secret for Staff & Borrower Authentication
JWT_SECRET=super-secret-jwt-key-loan-mgmt-system-psi-2026

# Allowed Frontend Origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SaaS payments: blank disables checkout. No live provider is implemented yet.
BILLING_PROVIDER=
# Set only with ENV=development and BILLING_PROVIDER=test; at least 32 characters.
BILLING_TEST_WEBHOOK_SECRET=

# Explicit provisioning commands only; never read by the running server.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# For go run ./cmd/admin, select the existing organization explicitly.
ADMIN_ORGANIZATION_ID=

